<?xml version="1.0"?>
<sdf version="1.9">
  <world name="three_obstacles_baseline">
    <gravity>0 0 -9.81</gravity>
    <physics name="contact_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.7 0.7 0.7 1</background></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 3 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation><direction>-0.3 0.2 -0.9</direction></light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>2 2</size></plane></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>2 2</size></plane></geometry><material><ambient>0.54 0.54 0.54 1</ambient><diffuse>0.54 0.54 0.54 1</diffuse></material></visual>
      </link>
    </model>

    <!-- All poses are in the future SO-101 base_link-aligned scene frame.
         They match config/mission_spec.json with zero random jitter. -->
    <include><name>payload</name><uri>model://payload</uri><pose>0.24 -0.29 0.02 0 0 0</pose></include>
    <include><name>triangular_pyramid</name><uri>model://triangular_pyramid</uri><pose>0.27 -0.12 0.06 0 0 0</pose></include>
    <include><name>tall_rectangular_prism</name><uri>model://tall_rectangular_prism</uri><pose>0.30 0.00 0.10 0 0 0</pose></include>
    <include><name>cylinder</name><uri>model://cylinder</uri><pose>0.27 0.18 0.05 0 0 0</pose></include>
    <include><name>dish</name><uri>model://dish</uri><pose>0.24 0.34 0 0 0 0</pose></include>
  </world>
</sdf>
