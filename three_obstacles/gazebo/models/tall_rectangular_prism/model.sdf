<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tall_rectangular_prism">
    <!-- Pose is the prism centre, so z=0.10 rests it on the ground. -->
    <static>true</static>
    <link name="tall_rectangular_prism_link">
      <collision name="tall_rectangular_prism_collision">
        <geometry><box><size>0.06 0.06 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <visual name="tall_rectangular_prism_visual">
        <geometry><box><size>0.06 0.06 0.20</size></box></geometry>
        <material><ambient>0.28 0.42 0.82 1</ambient><diffuse>0.28 0.42 0.82 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
