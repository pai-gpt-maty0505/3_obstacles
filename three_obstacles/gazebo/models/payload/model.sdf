<?xml version="1.0"?>
<sdf version="1.9">
  <model name="payload">
    <!-- The model pose is the payload geometric centre.  It is never attached
         to the robot: gravity and contact determine every motion. -->
    <static>false</static>
    <link name="payload_link">
      <gravity>true</gravity>
      <kinematic>false</kinematic>
      <inertial>
        <mass>0.036</mass>
        <!-- Ixx=Iyy=m*(0.03^2+0.04^2)/12; Izz=m*(0.03^2+0.03^2)/12 -->
        <inertia>
          <ixx>0.0000075</ixx>
          <iyy>0.0000075</iyy>
          <izz>0.0000054</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="payload_collision">
        <geometry><box><size>0.03 0.03 0.04</size></box></geometry>
        <surface>
          <friction><ode><mu>0.5</mu><mu2>0.5</mu2><fdir1>0 0 0</fdir1><slip1>0</slip1><slip2>0</slip2></ode></friction>
          <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1000000000000</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.0001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="payload_visual">
        <geometry><box><size>0.03 0.03 0.04</size></box></geometry>
        <material><ambient>0.05 0.65 0.75 1</ambient><diffuse>0.05 0.75 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
