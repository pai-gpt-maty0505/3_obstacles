<?xml version="1.0"?>
<sdf version="1.9">
  <model name="dish">
    <!-- Ground-level pose.  The floor top is z=0.002 and the rim top is
         z=0.012, which gives an actual 10 mm inside depth. -->
    <static>true</static>
    <link name="dish_link">
      <collision name="dish_floor_collision">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.002</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <visual name="dish_floor_visual">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.93 0.93 0.91 1</ambient><diffuse>0.93 0.93 0.91 1</diffuse></material>
      </visual>

      <!-- Sixteen overlapping facets form a continuous physical rim.  Each
           segment is 4 mm thick radially and 10 mm high above the floor. -->
      <collision name="rim_00_collision"><pose>0.028 0 0.007 0 0 0</pose><geometry><box><size>0.004 0.012 0.010</size></box></geometry><surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface></collision>
