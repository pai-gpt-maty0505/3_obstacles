<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cylinder">
    <!-- Pose is the cylinder centre, so z=0.05 rests it on the ground. -->
    <static>true</static>
    <link name="cylinder_link">
      <collision name="cylinder_collision">
        <geometry><cylinder><radius>0.04</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <visual name="cylinder_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.82 0.38 0.16 1</ambient><diffuse>0.82 0.38 0.16 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
